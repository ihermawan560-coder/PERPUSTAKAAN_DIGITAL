rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Buku collection
    match /buku/{bukuId} {
      allow read: if isValidId(bukuId);
      allow write: if isValidId(bukuId);
    }

    // Anggota collection
    match /anggota/{anggotaId} {
      allow read: if isValidId(anggotaId);
      allow write: if isValidId(anggotaId);
    }

    // Kelas collection
    match /kelas/{kelasId} {
      allow read: if isValidId(kelasId);
      allow write: if isValidId(kelasId);
    }

    // Transaksi collection
    match /transaksi/{transaksiId} {
      allow read: if isValidId(transaksiId);
      allow write: if isValidId(transaksiId);
    }

    // Pengaturan collection
    match /pengaturan/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isValidId(settingId);
    }

    // Sync metadata collection
    match /sync_metadata/{metaId} {
      allow read: if isValidId(metaId);
      allow write: if isValidId(metaId);
    }
  }
}
